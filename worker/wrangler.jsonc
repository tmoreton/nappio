{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nappio-pairing-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PAIRING_TTL_SECONDS": "300",
    "SESSION_TTL_SECONDS": "2592000",
    "TURN_TTL_SECONDS": "86400",
    "SHARDED_PAIRINGS_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "PAIRING_RATE_LIMITER",
      "namespace_id": "1000909",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIRINGS",
        "class_name": "PairingCoordinator"
      }
    ]
  },
  "exports": {
    "PairingCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
