{
  "name": "nappio",
  "description": "A private, peer-to-peer baby monitor built with Expo, WebRTC, and Cloudflare.",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "author": "Tim Moreton",
  "license": "Apache-2.0",
  "homepage": "https://github.com/tmoreton/nappio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmoreton/nappio.git"
  },
  "bugs": {
    "url": "https://github.com/tmoreton/nappio/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "expo": "~57.0.21",
    "expo-battery": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.23",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "site:build": "expo export --platform web --output-dir docs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit && npm --prefix worker run typecheck",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "worker:load-test": "node scripts/load-test-worker.mjs",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "tsx --test test/**/*.test.ts",
    "test:worker": "npm --prefix worker test",
    "check:scripts": "node --check scripts/check-turn-usage.mjs && node --check scripts/load-test-worker.mjs",
    "verify:expo-config": "node scripts/verify-expo-config.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:scripts && npm run verify:expo-config && npm test"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  },
  "private": true
}
